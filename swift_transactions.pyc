import logging
import yaml
import aiohttp
from elasticsearch import Elasticsearch
from typing import List, Dict, Any
import asyncio
from concurrent.futures import ThreadPoolExecutor

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

def initialize_elasticsearch(node_id: str, config_path: str) -> Elasticsearch:
    """
    Initializes an Elasticsearch client for each node in a distributed system.
    Each node connects to its own Elasticsearch instance specified in the configuration file.
    """
    with open(config_path, 'r') as file:
        config = yaml.safe_load(file)
    
    es_host = config.get('elasticsearch', {}).get('host', 'localhost')
    es_port = config.get('elasticsearch', {}).get('port', 9200)
    
    index_name = f"{node_id}_transactions"
    cdef Elasticsearch es = Elasticsearch([{"host": es_host, "port": es_port}], index=index_name)
    return es

async def fetch_swift_transactions(es: Elasticsearch, config_path: str) -> None:
    """
    Asynchronously fetches SWIFT transactions and indexes them into Elasticsearch.
    """
    cdef str headers = {
        "Authorization": f"Bearer {SWIFT_API_KEY}:{SWIFT_API_SECRET}",
        "Content-Type": "application/json"
    }
    
    async with aiohttp.ClientSession(headers=headers) as session:
        async with session.get(SWIFT_GPI_API_URL) as response:
            transactions = await response.json()
            actions = [{"_index": index_name, "_source": transaction} for transaction in transactions]
            bulk_index_with_retry(es, actions, index_name)
            logging.info(f"{len(transactions)} transactions indexed in Elasticsearch.")

async def fetch_payment_gateway_transactions() -> List[Dict[str, Any]]:
    """
    Asynchronously fetches transactions from the payment gateway.
    """
    headers = {
        "Authorization": f"Bearer {PAYMENT_GATEWAY_CONFIG['api_key']}:{PAYMENT_GATEWAY_CONFIG['api_secret']}",
        "Content-Type": "application/json"
    }

    async with aiohttp.ClientSession(headers=headers) as session:
        async with session.get(PAYMENT_GATEWAY_CONFIG["endpoint"]) as response:
            transactions = await response.json()
            return transactions

def bulk_index_with_retry(es: Elasticsearch, actions: list, index_name: str) -> None:
    """
    Bulk indexes documents with retry logic.
    """
    helpers.bulk(es, actions)

if __name__ == "__main__":
    # Example node identifiers for demonstration; adjust based on actual deployment
    node_ids = ['node1', 'node2']
    
    with ThreadPoolExecutor(max_workers=len(node_ids)) as executor:
        futures = []
        
        for node_id in node_ids:
            config_path = f'config_{node_id}.yaml'  # Unique configuration path for each node
            
            # Submit tasks to execute in parallel
            future = executor.submit(initialize_elasticsearch, node_id, config_path)
            futures.append(future)
            
            # Assuming fetch_swift_transactions and fetch_payment_gateway_transactions need to be adjusted similarly
            future = executor.submit(fetch_swift_transactions, future.result(), config_path)
            futures.append(future)
            
            future = executor.submit(fetch_payment_gateway_transactions, future.result())
            futures.append(future)
            
            # After fetching, submit the bulk indexing task
            future = executor.submit(bulk_index_with_retry, future.result(), future.result().actions, future.result().index_name)
            futures.append(future)
        
        # Wait for all futures to complete
        for future in futures:
            future.result()
